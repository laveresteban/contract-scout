# Copy to .env and fill in. Used by docker-compose.yml (the scheduler service).

# Where the real scrape backend lives (must include /api/v1).
#   compose network:      http://backend:8000/api/v1
#   backend on your host:  http://host.docker.internal:8001/api/v1
SCRAPE_API_BASE=http://host.docker.internal:8001/api/v1

# Bearer token for the signed-in account whose saved searches should be scraped.
# Get it from the browser after signing in: localStorage["contract-scout:token"].
SCRAPE_AUTH_TOKEN=

# Optional
SCRAPE_TIMEOUT=60
ONLY_ALERTS=false     # true = only run saved searches with alerts enabled
RUN_ON_START=false    # true = run one pass immediately on container start
